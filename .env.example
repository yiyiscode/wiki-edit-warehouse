# 複製成 .env 後填寫。.env 不進版控。

# Wikimedia 要求 User-Agent 含聯絡方式(網址或 email),否則限速 10 次/分(合規為 200 次/分)。
# 格式:<client>/<version> (<聯絡方式>);本專案用 repo 網址,不放個人 email。
WIKI_USER_AGENT=wiki-edit-warehouse/0.1 (https://github.com/<帳號>/wiki-edit-warehouse)

# 本機開發用的預設值,對應 docker-compose.yml
DATABASE_URL=postgresql://wew:wew@localhost:5432/wew
